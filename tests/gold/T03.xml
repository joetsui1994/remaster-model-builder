<beast version="2.0" namespace="beast.base.inference.parameter:beast.base.inference:remaster">
  <run spec="Simulator" nSims="1">
    <simulate id="traj" spec="DeterministicTrajectory" maxTime="10">
      <population id="X" spec="RealParameter" value="1000"/>
      <reaction spec="Reaction" rate="1.2"> X -> 2X </reaction>
      <reaction spec="Reaction" rate="1"> X -> 0 </reaction>
    </simulate>
    <logger fileName="deterministic.traj"><log idref="traj"/></logger>
  </run>
</beast>
