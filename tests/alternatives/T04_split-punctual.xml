<beast version="2.0" namespace="beast.base.inference.parameter:beast.base.inference:remaster">
  <run spec="Simulator" nSims="1">
    <simulate id="traj" spec="StochasticTrajectory" maxTime="5">
      <population id="X" spec="RealParameter" value="100"/>
      <samplePopulation id="sample" spec="RealParameter" value="0"/>
      <reaction spec="PunctualReaction" n="5" times="1"> X -> sample </reaction>
      <reaction spec="PunctualReaction" n="7" times="2"> X -> sample </reaction>
      <reaction spec="PunctualReaction" n="10" times="5"> X -> sample </reaction>
    </simulate>
    <logger fileName="fixed-samples.traj"><log idref="traj"/></logger>
  </run>
</beast>
