<beast version="2.0" namespace="beast.base.inference.parameter:beast.base.inference:remaster:beast.base.evolution.tree.coalescent">
  <run spec="Simulator" nSims="1">
    <simulate id="tree" spec="SimulatedTree">
      <trajectory id="traj" spec="CoalescentTrajectory" maxTrajLogAge="10">
        <population id="pop" spec="ConstantPopulation">
          <popSize spec="RealParameter" value="1.0"/>
        </population>
        <reaction spec="PunctualReaction" n="10" times="0"> 0 -> pop </reaction>
      </trajectory>
    </simulate>
    <logger fileName="constant-coalescent.trees" mode="tree"><log spec="TypedTreeLogger" tree="@tree"/></logger>
  </run>
</beast>
